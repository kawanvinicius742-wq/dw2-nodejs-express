            <div class="card-body">
                    <!-- action: para onde os dados serão enviados -->
                    <!-- method="POST": Método HTTP que envia dados de forma oculta -->
                    <form action="/pedidos/cadastrar" method="POST">

                        <label for="numero">Número do pedido:</label>
                        <input type="text" id="numero" name="numero" placeholder="Insira o número do pedido" class="form-control" required>

                        <label for="valor">Valor do pedido:</label>
                        <input type="text" id="valor" name="valor" placeholder="Insira o valor do pedido" class="form-control" required>
                        <br>
                        <!-- Botão de cadastrar -->
                        <button type="submit" class="btn btn-success">Cadastrar</button>
                        <!-- Botão de limpar -->
                        <button type="reset" class="btn btn-danger">Limpar</button>
                    </form>
                    <hr>
                </div>
        </div>
    </div>
<!--  -->
      <div class="container">
            <div class="card">
                <div class="card-header">
                    <h1>Pedidos</h1>
                </div>
                <div class="card-body">
                    <table>
                        <thead>
                            <tr>
                                <th></th>
                                <th>Número:</th>
                                <th>Valor:</th>
                                <!-- Nova coluna de Ações -->
                                <th style="text-align: center;" colspan="2">Ações:</th>
                            </tr>
                        </thead>
                        
                        <tbody>
                            <% pedidos.forEach(pedido => { %>
                                <tr>
                                    <td><img src="imgs/avatar.png" width="30px"></td>
                                  
                                    <td>
                                        <%= pedido.numero %>
                                    </td>
                                    <td>
                                        <%= pedido.valor %>
                                    </td>
                                    <!-- Botão de Editar -->
                                    <td>
                                        <a class="btn btn-warning" href="/pedidos/editar/<%= pedido.id %>">Editar</a>
                                    </td>
                                    <!-- Botão de Excluir -->
                                    <td>
                                        <!-- Parâmetro passado através da URL -->
                                        <a class="btn btn-danger" href="/pedidos/excluir/<%= pedido.id %>" onclick="return confirm('Deseja mesmo excluir o pedido <%= pedido.numero %>')">Excluir</a>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

<%- include ('partials/footer.ejs') %>
