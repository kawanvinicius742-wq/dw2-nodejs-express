<%- include ('partials/header.ejs') %> <%- include ('partials/navbar.ejs') %>

<div class="container">
  <div class="card">
    <div class="card-header">
      <h1>Editar Pedido</h1>
      <hr />
    </div>
    <div class="card-body">
      <form action="/pedidos/alterar" method="POST">
        
        <label for="cpf">Número do pedido</label>
        <input
          type="text"
          name="numero"
          id="numero"
          class="form-control"
          required
          value="<%= pedido.numero %>"
        />
        <label for="endereco">Valor do pedido</label>
        <input
          type="text"
          name="valor"
          id="valor"
          class="form-control"
          required
          value="<%= pedido.valor %>"
        />
        <!-- CAMPO INVISÍVEL COM A ID DO CLIENTE -->
        <input type="hidden" name="id" id="id" value="<%= pedido.id %>" />
        <br />
        <button
          type="submit"
          class="btn btn-warning"
          onclick="
            return confirm(
              'Deseja mesmo alterar o pedido <%= pedido.numero %>',
            );
          "
        >
          Alterar
        </button>
        <a href="/pedidos">
          <button type="button" class="btn btn-danger">Cancelar</button>
        </a>
      </form>
    </div>
  </div>
</div>

<%- include ('partials/footer.ejs') %>
