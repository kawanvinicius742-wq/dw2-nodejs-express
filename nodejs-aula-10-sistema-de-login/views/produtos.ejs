            <div class="card-body">
                    <!-- action: para onde os dados serão enviados -->
                    <!-- method="POST": Método HTTP que envia dados de forma oculta -->
                    <form action="/produtos/cadastrar" method="POST">
                        <label for="nome">Nome do produto:</label>
                        <input type="text" id="nome" name="nome" placeholder="Insira o nome do produto" class="form-control" required>

                        <label for="preco">Preço do produto:</label>
                        <input type="text" id="preco" name="preco" placeholder="Insira o preço do produto" class="form-control" required>

                        <label for="categoria">Categoria do produto:</label>
                        <input type="text" id="categoria" name="categoria" placeholder="Insira a categoria do produto" class="form-control" required>
                        <br>
                        <!-- Botão de cadastrar -->
                        <button type="submit" class="btn btn-success">Cadastrar</button>
                        <!-- Botão de limpar -->
                        <button type="reset" class="btn btn-danger">Limpar</button>
                    </form>
                    <hr>
                </div>
        </div>
    </div>

    <!--  -->

          <div class="container">
            <div class="card">
                <div class="card-header">
                    <h1>Produtos</h1>
                </div>
                <div class="card-body">
                    <table>
                        <thead>
                            <tr>
                                <th></th>
                                <th>Nome:</th>
                                <th>Preço:</th>
                                <th>Categoria:</th>
                                <!-- Nova coluna de Ações -->
                                <th style="text-align: center;" colspan="2">Ações:</th>
                            </tr>
                        </thead>
                        
                        <tbody>
                            <% produtos.forEach(produto => { %>
                                <tr>
                                    <td><img src="imgs/avatar.png" width="30px"></td>
                                    <td>
                                        <%= produto.nome %>
                                    </td>
                                    <td>
                                        <%= produto.preco %>
                                    </td>
                                    <td>
                                        <%= produto.categoria %>
                                    </td>
                                    <!-- Botão de Editar -->
                                    <td>
                                        <a class="btn btn-warning" href="/produtos/editar/<%= produto.id %>">Editar</a>
                                    </td>
                                    <!-- Botão de Excluir -->
                                    <td>
                                        <!-- Parâmetro passado através da URL -->
                                        <a class="btn btn-danger" href="/produtos/excluir/<%= produto.id %>" onclick="return confirm('Deseja mesmo excluir o produto <%= produto.nome %>')">Excluir</a>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

<%- include ('partials/footer.ejs') %>
